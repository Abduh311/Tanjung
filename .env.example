# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / VITE_APP_URL: The URL where this applet is hosted (e.g. https://your-project.vercel.app or GitHub Pages).
APP_URL="https://your-project.vercel.app"
VITE_APP_URL="https://your-project.vercel.app"
PUBLIC_TUNNEL_URL=""

# VITE_BASE_PATH: Subpath for GitHub Pages project sites (e.g. /repo-name/). Leave "/" for root hosting.
VITE_BASE_PATH="/"

# (Optional) Supabase configuration if connecting to Supabase:
# VITE_SUPABASE_URL="https://your-project.supabase.co"
# VITE_SUPABASE_ANON_KEY="your-anon-key"
